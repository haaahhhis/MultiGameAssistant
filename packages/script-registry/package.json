{
  "name": "@adg/script-registry",
  "version": "0.1.0",
  "private": true,
  "description": "Cordis host plugin: the script library (packs, GitHub installs, local imports, side-by-side versions, environment checks) as agent tools and the scripts gateway capability",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@adg/installer": "workspace:*",
    "@adg/pack-schema": "workspace:*",
    "@adg/packs": "workspace:*",
    "@adg/protocol": "workspace:*",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "devDependencies": {
    "@adg/gateway": "workspace:*",
    "@adg/test-kit": "workspace:*",
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-credentials": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-user-approval": "0.2.1-alpha.2",
    "@types/node": "^24.13.3"
  }
}
