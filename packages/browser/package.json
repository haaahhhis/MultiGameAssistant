{
  "name": "@adg/browser",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Cordis host plugin: the agent's browser_* tools for the desktop app's built-in browser (apps/desktop/browser.mjs), reached over its loopback bridge",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@adg/protocol": "workspace:*",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "devDependencies": {
    "@adg/gateway": "workspace:*",
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-attachment": "0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3",
    "@types/node": "^24.13.3"
  }
}
