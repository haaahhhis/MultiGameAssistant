{
  "name": "@adg/bundle",
  "version": "0.1.0",
  "private": true,
  "description": "Profile layer: keeps the dsh agent and host services, mounts the MultiGameAssistant gateway and feature plugins",
  "type": "module",
  "files": [
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@adg/analyzer": "workspace:*",
    "@adg/emulator": "workspace:*",
    "@adg/feishu": "workspace:*",
    "@adg/game-intel": "workspace:*",
    "@adg/gateway": "workspace:*",
    "@adg/guard": "workspace:*",
    "@adg/intervene": "workspace:*",
    "@adg/monitor": "workspace:*",
    "@adg/notify": "workspace:*",
    "@adg/orchestrator": "workspace:*",
    "@adg/runner": "workspace:*",
    "@adg/scheduler": "workspace:*",
    "@adg/script-registry": "workspace:*"
  }
}
