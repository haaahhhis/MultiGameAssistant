{
  "name": "@adg/test-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Local simulation environment for tests: scenario-driven fake scripts, a fake GitHub releases server, and a manual clock",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./fake-script-cli": "./lib/fake-script-cli.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.13.3"
  }
}
