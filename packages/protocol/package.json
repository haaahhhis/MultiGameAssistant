{
  "name": "@adg/protocol",
  "version": "0.1.0",
  "private": true,
  "description": "Versioned UI protocol between dsh and any client: zod schemas, TS types, exported JSON Schema",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./node": {
      "types": "./lib/node.d.ts",
      "default": "./lib/node.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "schema": "node scripts/export-schema.ts"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3"
  }
}
