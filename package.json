{
  "name": "@adg/root",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "typecheck": "pnpm -r --workspace-concurrency=1 run typecheck",
    "test": "node --test \"packages/*/test/*.test.ts\" \"scripts/test/*.test.mjs\"",
    "schema": "pnpm --filter @adg/protocol run schema",
    "dev:home": "node scripts/dev-home.mjs",
    "dev:host": "node scripts/run-dsh.mjs",
    "dev:web": "pnpm --filter @adg/web run dev",
    "smoke": "node scripts/smoke.mjs",
    "setup:electron": "node scripts/fetch-electron.mjs",
    "desktop": "pnpm --filter @adg/desktop start",
    "desktop:dev": "pnpm --filter @adg/web run build && pnpm --filter @adg/desktop start",
    "e2e": "node scripts/e2e-chat.mjs",
    "dev:fake-model": "node scripts/dev-fake-model.mjs",
    "e2e:scripts": "node scripts/e2e-scripts.mjs",
    "e2e:run": "node scripts/e2e-run.mjs",
    "e2e:monitor": "node scripts/e2e-monitor.mjs",
    "e2e:pipelines": "node scripts/e2e-pipelines.mjs",
    "e2e:intervene": "node scripts/e2e-intervene.mjs",
    "e2e:sandbox": "node scripts/e2e-sandbox-shell.mjs",
    "lint:tools": "node scripts/lint-tools.mjs",
    "e2e:games": "node scripts/e2e-games.mjs",
    "check:sites": "node scripts/check-game-sites.mjs",
    "e2e:permissions": "node scripts/e2e-permissions.mjs",
    "e2e:questions": "node scripts/e2e-questions.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.1-alpha.2",
    "@types/node": "^24.13.3",
    "typescript": "6.0.3"
  }
}
